# Postgres (service "db" de docker-compose.yml)
POSTGRES_USER=makrouna
POSTGRES_PASSWORD=makrouna
POSTGRES_DB=makrouna
POSTGRES_PORT=5432

# Chaîne de connexion utilisée par l'application (drizzle-orm/node-postgres)
# Depuis l'hôte (pnpm dev) : localhost. Depuis un conteneur du même réseau compose : db.
DATABASE_URL=postgres://makrouna:makrouna@localhost:5432/makrouna
